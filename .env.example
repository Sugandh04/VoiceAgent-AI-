# ── LiveKit WebRTC ────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# ── LLM (use OpenAI, Sarvam, or both) ────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
SARVAM_API_KEY=REPLACE_ME

# ── Speech-to-Text & TTS ──────────────────────────────────────────────────────
DEEPGRAM_API_KEY=REPLACE_ME

# ── PSTN Outbound Calls (Exotel) ─────────────────────────────────────────────
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=+91XXXXXXXXXX
EXOTEL_APP_ID=

# ── WhatsApp Cloud API (optional) ─────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=voice_agent_verify_token_12345

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./voice_agent.db

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENV=development

# ── CORS (production only) ────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://yourdomain.com
